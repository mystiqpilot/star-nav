<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The light look from Android 8.1 (API 27), which has a light navigation bar attribute; same as values/themes.xml otherwise. -->
    <style name="Theme.StarlinkNav" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
